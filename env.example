# Public browser runtime configuration for the Shelby review environment.
VITE_SHELBY_NETWORK=shelbynet
VITE_SHELBY_LOCATION=shelbynet-1
VITE_SHELBY_USD_METADATA=
VITE_SHELBY_API_KEY=
# Backward-compatible alias used when VITE_SHELBY_API_KEY is empty.
VITE_APTOS_API_KEY=

# Optional endpoint overrides for a Shelby private/local environment.
# VITE_SHELBY_RPC_URL=
# VITE_SHELBY_INDEXER_URL=
# VITE_APTOS_FULLNODE_URL=
# VITE_APTOS_INDEXER_URL=
# VITE_SHELBY_EXPLORER_URL=
# VITE_APTOS_EXPLORER_URL=


# Optional P2 private-environment integration.
VITE_KARYA_REGISTRY_ADDRESS=
VITE_KARYA_KEY_SERVICE_URL=
# Server-only Vercel function configuration. Do not expose these as VITE_ variables.
# KARYA_REGISTRY_ADDRESS=
# KARYA_APTOS_FULLNODE_URL=
# KARYA_APTOS_API_KEY=
# KARYA_SIGNING_APPLICATION=https://your-karyachain-domain.example
# KARYA_APTOS_CHAIN_ID=
# KARYA_KEY_ENCRYPTION_SECRET=