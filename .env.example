# Public browser runtime configuration for the Shelby review environment.
VITE_SHELBY_NETWORK=shelbynet
VITE_SHELBY_LOCATION=shelbynet-1
VITE_SHELBY_API_KEY=
# Backward-compatible alias used when VITE_SHELBY_API_KEY is empty.
VITE_APTOS_API_KEY=

# Optional endpoint overrides for a Shelby private/local environment.
# VITE_SHELBY_RPC_URL=
# VITE_SHELBY_INDEXER_URL=
# VITE_APTOS_FULLNODE_URL=
# VITE_APTOS_INDEXER_URL=
# VITE_SHELBY_EXPLORER_URL=
# VITE_APTOS_EXPLORER_URL=
